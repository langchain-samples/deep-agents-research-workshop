# Copy this file to .env and fill in the placeholders (the <...> values).
#
# Minimum for the CORE demo (Modules 1 & 2):
#   OPENAI_API_KEY, TAVILY_API_KEY, LANGSMITH_API_KEY, WORKSPACE_ID
# Module 1 only:  OPENAI_API_KEY + TAVILY_API_KEY
# Modules 3 & 4 (optional): reuse the same keys — nothing extra to add.

# --- LangSmith --------------------------------------------------------------
# Tracing (all modules) works with ANY LangSmith key.
# The Module 2 DEPLOY step (`langgraph deploy`) needs a SERVICE key:
#     lsv2_sk_...   (create in LangSmith -> Settings -> API Keys)
# A personal key (lsv2_pt_...) will fail deploy with a 403.
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-service-key>"     # lsv2_sk_...
LANGSMITH_PROJECT="modular-workshops"

# `langgraph deploy` strips LANGSMITH_API_KEY on upload, so the deployed agent's
# gateway auth reads this copy instead. Set it to the SAME value as above.
LANGSMITH_API_KEY_GATEWAY="<langsmith-service-key>"

# Workspace ID for the Module 2 gateway policy. LangSmith -> Settings -> Workspace.
WORKSPACE_ID="<workspace-id>"

# --- Model provider (default is OpenAI; set whichever you use) --------------
OPENAI_API_KEY="<openai-api-key>"
# ANTHROPIC_API_KEY="<anthropic-api-key>"

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# --- Web search (Tavily) — used by the research agent in every module -------
TAVILY_API_KEY="<tavily-api-key>"
